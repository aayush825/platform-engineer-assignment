# Production environment file example.
# Deploy the real file to /etc/platform-app/platform-app.env with 0640 perms,
# owned by root:platform so only the service account/root can read it.
# NEVER commit the real values.
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000
SERVICE_NAME=platform-app
# In production, prefer AWS Secrets Manager / SSM Parameter Store over a file:
DATABASE_URL=postgresql://USER:PASSWORD@db.internal:5432/platform
LOG_LEVEL=INFO
SECRET_KEY=REPLACE_WITH_SECRET_FROM_SECRETS_MANAGER
DB_CONNECT_TIMEOUT=2
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=30
