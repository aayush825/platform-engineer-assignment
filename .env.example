# Copy to .env for local development. NEVER commit a real .env.
# All values below are placeholders only.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
SERVICE_NAME=platform-app
# Local Docker Compose PostgreSQL (local-only credentials, not production):
DATABASE_URL=postgresql://platform:platform@127.0.0.1:5432/platform
LOG_LEVEL=INFO
# Generate your own; do not commit a real secret:
SECRET_KEY=replace-with-a-random-secret
DB_CONNECT_TIMEOUT=2
